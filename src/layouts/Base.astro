---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '@/components/react/Sidebar';
import PomodoroTimer from '@/components/react/PomodoroTimer';
import { getSidebarAreas } from '@/lib/content';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Plataforma de estudio para el EGEL Plus ICOMPU (CENEVAL)' } = Astro.props;
const areas = await getSidebarAreas();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · EGEL ICOMPU</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d0b0a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        // The ClientRouter replaces <html> attributes on every navigation, so the
        // persisted classes are re-applied after each swap (before paint).
        const apply = () => {
          const root = document.documentElement;
          try {
            // persistentAtom stores the raw string ("light"/"dark"), not JSON.
            const t = (localStorage.getItem('ceneval:theme') ?? 'dark').replace(/"/g, '');
            root.classList.toggle('dark', t !== 'light');
          } catch {}
          try {
            const collapsed = JSON.parse(localStorage.getItem('ceneval:sidebar-collapsed') ?? 'false');
            root.classList.toggle('sidebar-collapsed', collapsed === true);
          } catch {}
        };
        apply();
        if (!window.__cenevalRootState) {
          window.__cenevalRootState = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <input id="nav-toggle" type="checkbox" class="peer hidden" />
    <label for="nav-toggle" class="panel fixed left-3 top-3 z-30 px-3 py-2 text-sm lg:hidden">☰ Menú</label>
    <aside
      id="app-sidebar"
      class="app-sidebar fixed inset-y-0 left-0 z-20 hidden w-80 border-r border-[color:var(--line)] bg-[color:var(--bg)] pt-12 peer-checked:block lg:block lg:pt-0"
    >
      {/* Persisted on the island itself so it keeps its state but still receives the new currentPath. */}
      <Sidebar client:load transition:persist="sidebar" areas={areas} currentPath={currentPath} />
    </aside>
    <script is:inline>
      // Restore the sidebar scroll position after a full page load and reveal the current item.
      // Client-side navigations keep the persisted sidebar, so this only runs once.
      (() => {
        if (window.__cenevalSidebarScroll) return;
        window.__cenevalSidebarScroll = true;
        const KEY = 'ceneval:sidebar-scroll';
        const nav = document.querySelector('#app-sidebar nav');
        if (!nav) return;
        try {
          const saved = Number(sessionStorage.getItem(KEY));
          if (saved > 0) nav.scrollTop = saved;
        } catch {}
        const active = nav.querySelector('[aria-current="page"]');
        if (active && nav.clientHeight > 0) {
          const n = nav.getBoundingClientRect();
          const a = active.getBoundingClientRect();
          const margin = 48;
          if (a.top < n.top + margin || a.bottom > n.bottom - margin) {
            nav.scrollTop += a.top - n.top - (nav.clientHeight - a.height) / 2;
          }
        }
        addEventListener('pagehide', () => {
          try {
            sessionStorage.setItem(KEY, String(nav.scrollTop));
          } catch {}
        });
        // Browsers without Element.moveBefore() detach the persisted island during the swap,
        // which resets its scroll; carry the position over manually.
        let top = 0;
        document.addEventListener('astro:before-swap', () => {
          top = document.querySelector('#app-sidebar nav')?.scrollTop ?? 0;
        });
        document.addEventListener('astro:after-swap', () => {
          const current = document.querySelector('#app-sidebar nav');
          if (current && current.scrollTop !== top) current.scrollTop = top;
        });
      })();
    </script>
    <button
      type="button"
      class="sidebar-toggle"
      aria-controls="app-sidebar"
      aria-label="Ocultar o mostrar el menú lateral"
      title="Ocultar/mostrar menú (Ctrl+B)"
      data-sidebar-toggle
    >
      <span class="sidebar-toggle-icon inline-block text-xs transition-transform" aria-hidden="true">‹</span>
    </button>
    <script>
      // Bundled scripts run once per visit; the button is replaced on every navigation,
      // so use event delegation and re-sync its state on each page load.
      const KEY = 'ceneval:sidebar-collapsed';
      const root = document.documentElement;
      const sync = () =>
        document
          .querySelector('[data-sidebar-toggle]')
          ?.setAttribute('aria-expanded', String(!root.classList.contains('sidebar-collapsed')));
      const toggle = () => {
        const collapsed = root.classList.toggle('sidebar-collapsed');
        localStorage.setItem(KEY, JSON.stringify(collapsed));
        sync();
      };
      document.addEventListener('astro:page-load', sync);
      document.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('[data-sidebar-toggle]')) toggle();
      });
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
          e.preventDefault();
          toggle();
        }
      });
    </script>
    <main class="app-main mx-auto max-w-3xl px-5 py-16 lg:ml-80 lg:max-w-none lg:px-12 lg:py-10">
      <div class="mx-auto max-w-3xl">
        <slot />
      </div>
    </main>
    {/* Pomodoro: floating pill (only visible when the sidebar is hidden) and the engine that keeps it running. */}
    <PomodoroTimer client:only="react" transition:persist="pomodoro-pill" variant="pill" />
    <script>
      import { startPomodoroEngine } from '@/lib/pomodoro-store';
      startPomodoroEngine();
    </script>
  </body>
</html>
