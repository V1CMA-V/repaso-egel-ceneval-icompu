---
import Base from '@/layouts/Base.astro';
import Simulacro from '@/components/react/Simulacro';
---

<Base title="Simulacros">
  <p class="text-xs uppercase tracking-widest text-accent">Entrenamiento con tiempo real</p>
  <h1 class="font-display mt-1 text-4xl font-extrabold">Simulacros</h1>
  <p class="mt-2 text-sm text-[color:var(--muted)]">
    Practica bajo las condiciones del examen: cronómetro, sin retroalimentación y con revisión al final.
  </p>
  <div class="mt-6"><Simulacro client:only="react" /></div>
</Base>
