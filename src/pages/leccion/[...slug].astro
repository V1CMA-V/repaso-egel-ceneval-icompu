---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import CompleteButton from '@/components/react/CompleteButton';
import LessonPractice from '@/components/LessonPractice.astro';
import { getLessons } from '@/lib/content';
import { findArea, findSection } from '@/lib/curriculum';

export async function getStaticPaths() {
  const lessons = await getLessons();
  const ordered = lessons.sort((a, b) => {
    const sa = a.id.split('/').slice(0, 2).join('/');
    const sb = b.id.split('/').slice(0, 2).join('/');
    return sa === sb ? a.data.order - b.data.order : sa.localeCompare(sb);
  });
  return ordered.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: { lesson, prev: ordered[i - 1], next: ordered[i + 1] },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content, headings } = await render(lesson);
const [areaSlug, sectionSlug] = lesson.id.split('/');
const area = findArea(areaSlug!);
const section = findSection(`${areaSlug}/${sectionSlug}`);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={lesson.data.title} description={lesson.data.summary}>
  <p class="text-xs uppercase tracking-widest text-accent">{area?.title} · {section?.code} {section?.title}</p>
  <h1 class="font-display mt-2 text-4xl font-extrabold leading-tight sm:text-5xl">{lesson.data.title}</h1>
  <p class="mt-3 text-[color:var(--muted)]">{lesson.data.summary}</p>
  <p class="mt-3 flex flex-wrap gap-2 text-xs">
    <span class="panel px-3 py-1">⏱ {lesson.data.readMinutes} min de lectura</span>
    {lesson.data.examWeight && <span class="panel px-3 py-1">🎯 {lesson.data.examWeight}</span>}
  </p>

  {toc.length > 0 && (
    <nav class="panel mt-6 p-4 text-sm" aria-label="En esta lección">
      <p class="mb-2 text-xs font-bold uppercase tracking-widest text-[color:var(--muted)]">En esta lección</p>
      <ol class="grid gap-1 sm:grid-cols-2">
        {toc.map((h, i) => (
          <li><a class="hover:text-accent" href={`#${h.slug}`}><span class="mr-2 text-[color:var(--muted)]">{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  )}

  <article class="prose prose-lesson prose-lg mt-8 dark:prose-invert">
    <Content />
  </article>

  <LessonPractice lessonId={lesson.id} sectionKey={`${areaSlug}/${sectionSlug}`} title={lesson.data.title} />

  <div class="mt-10"><CompleteButton client:load lessonId={lesson.id} /></div>

  <div class="mt-8 grid gap-3 sm:grid-cols-2">
    {prev ? (
      <a href={`/leccion/${prev.id}`} class="panel p-4 hover:border-accent">
        <span class="text-xs uppercase tracking-widest text-[color:var(--muted)]">← Anterior</span>
        <span class="mt-1 block font-semibold">{prev.data.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={`/leccion/${next.id}`} class="panel p-4 text-right hover:border-accent">
        <span class="text-xs uppercase tracking-widest text-[color:var(--muted)]">Siguiente →</span>
        <span class="mt-1 block font-semibold">{next.data.title}</span>
      </a>
    ) : <span />}
  </div>
  <p class="mt-4 text-center text-sm">
    <a class="text-accent underline" href={`/examen/${areaSlug}/${sectionSlug}`}>Ir al examen de la sección →</a>
  </p>
</Base>
